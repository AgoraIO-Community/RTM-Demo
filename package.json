{
  "name": "rtm-scenario-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "dev:https": "vite --mode https --host 127.0.0.1 --port 8080",
    "build": "tsc -b && vite build",
